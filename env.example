# PayPal AI Agent Gateway — environment variables
# Copy this file to .env.local and fill in your values:
#   cp env.example .env.local
#
# .env.local is git-ignored. NEVER commit real credentials.

# PayPal REST app credentials (sandbox) from https://developer.paypal.com
PAYPAL_CLIENT_ID=Tu_Client_Id_Sandbox_De_PayPal
PAYPAL_CLIENT_SECRET=Tu_Client_Secret_Sandbox_De_PayPal

# Optional: Sandbox (default) or Production
PAYPAL_ENVIRONMENT=Sandbox

# ── Google Gemini, two ways ──────────────────────────────────────────────
# Pick ONE. GCP_PROJECT wins if both are set.

# A) Vertex AI — billed to this GCP project, which is where hackathon
#    credits live. Auth is Application Default Credentials, so no secret is
#    stored here at all: run this once on your machine —
#      bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
#    Requires the "Vertex AI API" enabled on the project.
GCP_PROJECT=
# Where the text model is served from. Defaults to `global` when unset —
# and `global` is not a taste: gemini-3.8-flash 404s from us-central1 and
# only answers from `global`. Verified against the real SDK. Region and model
# are not independent choices, and a location the configured model is not
# served from looks exactly like a model that does not exist.
GCP_LOCATION=global

# B) Gemini API — a key. Sent automatically by the SDK in the
#    `x-goog-api-key` header, so nothing has to append `?key=` by hand.
#    Where the key came from matters, and it IS verified now (08-oct):
#    - aistudio.google.com → billed to a Gemini API account of its own
#    - GCP console → Credentials → API key → tied to that GCP project
#      ⚠️ A key with no prepaid credit returns HTTP 402 "prepayment credits
#      are depleted" — which reads like a model failure and is billing. Our
#      project uses Vertex (GCP_PROJECT, route A); leave this empty unless
#      you have a funded AI Studio key. `configuredAuth()` picks A when both
#      are set, and a failed call reports the real reason either way.
# Where PayPal sends the browser back after an approval or a cancellation.
# Absolute URLs, and they must match the port this app runs on — the default
# in code is localhost:3000, matching the dev server. Optional: omit and the
# code fills in /paypal/return and /paypal/cancel, which both exist.
# PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
# PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel

GEMINI_API_KEY=

# Optional: overrides the default text model.
# gemini-2.5-flash, chosen for speed: 1.3 s per parser call measured on 1-nov.
# gemini-3.8-flash answered the SAME prompt and schema in 5.7 s, 27 s and 142 s
# — and thinkingBudget: 0 did not steady it — which is a demo nobody watches.
GEMINI_MODEL=gemini-2.5-flash

# ── AG Grid and AG Studio licences ───────────────────────────────────────
# Two products, two licence stores, two keys. They do NOT substitute for each
# other: a Studio key fed to ag-grid-enterprise prints "Invalid License Key /
# Your license key is not valid" even though the key is perfectly valid — its
# type code is simply unknown to the grid's table.
#
#   ag-grid-enterprise : 01 GRID · 02 CHARTS · 0102 BOTH
#   ag-studio          : those three + 03A CORE · 03B PRO · 03C PRO-AI
#
# Without a Grid key the app registers Community modules on purpose, so nothing
# warns and nothing lies; Enterprise (Master-Detail, AG Charts) enables itself
# the moment a Grid key is set. See lib/grid/licence.ts.
#
# NOT a secret: both vendors document that a key ships inside the client bundle
# and ask only that it is not advertised. Kept in .env.local so a revoked or
# expired key can never be committed and break someone's build.
#
# A) GRID + CHARTS — request at https://www.ag-grid.com/license-pricing/
#    ("Get a trial licence", 30 days).
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
#
# B) AG STUDIO — request at
#    https://www.ag-grid.com/studio/license-pricing/?tab=trial (45 days; ours
#    expires 2026-11-21, after the 2026-11-12 deadline). Read but not yet
#    wired: it becomes active when a Studio component lands (roadmap S1).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# ── Gemini Live (voice) ──────────────────────────────────────────────────
# The spoken agent runs on the Live API, which is a different endpoint from
# generateContent AND a different region. These two are NOT independent:
#   gemini-2.5-flash   → answers from `global` (the default text model)
#   gemini-3.8-flash   → answers from `global`,   404s from us-central1
#   gemini-3.8-live    → answers from us-central1, 404s from `global`
# All verified against the real SDK. Leave these alone unless you have
# re-verified the model in the region you picked.
GEMINI_LIVE_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-3.8-live
# Which of the ~30 prebuilt voices speaks for the agent (Aoede, Achird,
# Zephyr, Puck, Charon, Fenrir, ...). Ignored when the Live model is
# unavailable — the console still shows what was said.
GEMINI_LIVE_VOICE=Aoede
