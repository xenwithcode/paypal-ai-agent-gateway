# PayPal AI Agent Gateway — environment variables
# Copy this file to .env.local and fill in your values:
#   cp env.example .env.local
#
# .env.local is git-ignored. NEVER commit real credentials.

# PayPal REST app credentials (sandbox) from https://developer.paypal.com
PAYPAL_CLIENT_ID=Tu_Client_Id_Sandbox_De_PayPal
PAYPAL_CLIENT_SECRET=Tu_Client_Secret_Sandbox_De_PayPal

# Optional: Sandbox (default) or Production
PAYPAL_ENVIRONMENT=Sandbox

# ── Google Gemini, two ways ──────────────────────────────────────────────
# Pick ONE. GCP_PROJECT wins if both are set.

# A) Vertex AI — billed to this GCP project, which is where hackathon
#    credits live. Auth is Application Default Credentials, so no secret is
#    stored here at all: run this once on your machine —
#      bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
#    Requires the "Vertex AI API" enabled on the project.
GCP_PROJECT=
# Optional, defaults to us-central1
GCP_LOCATION=us-central1

# B) Gemini API — a key. Sent automatically by the SDK in the
#    `x-goog-api-key` header, so nothing has to append `?key=` by hand.
#    Where the key came from matters and is NOT verified here:
#    - aistudio.google.com → billed to a Gemini API account of its own
#    - GCP console → Credentials → API key → tied to that GCP project
#      (whether GCP credits cover it: UNVERIFIED)
GEMINI_API_KEY=Tu_API_Key_De_Google_AI_Studio

# Optional: overrides the default model (gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
