# PayPal AI Agent Gateway — environment variables
# Copy this file to .env.local and fill in your values:
#   cp env.example .env.local
#
# .env.local is git-ignored. NEVER commit real credentials.

# PayPal REST app credentials (sandbox) from https://developer.paypal.com
PAYPAL_CLIENT_ID=Tu_Client_Id_Sandbox_De_PayPal
PAYPAL_CLIENT_SECRET=Tu_Client_Secret_Sandbox_De_PayPal

# Optional: Sandbox (default) or Production
PAYPAL_ENVIRONMENT=Sandbox

# Google AI Studio API key with access to the Gemini 3.8 series
GEMINI_API_KEY=Tu_API_Key_De_Google_AI_Studio

# Optional: overrides the default model (gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
