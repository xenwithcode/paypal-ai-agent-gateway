  "cards": [
    {
      "dot": "cyan",
      "title": "The thesis",
      "items": [
        "The agent requests · the server judges · the human approves",
        "Purchase orders for agents: ceiling, recipient, window, condition — approved once, enforced on every attempt",
        "The model is told what it may do; it never holds a credential"
      ]
    },
    {
      "dot": "emerald",
      "title": "Money moves in PayPal",
      "items": [
        "Authorize → hold → capture, or release: the app holds the permission, PayPal holds the money",
        "Approval happens inside PayPal's own UI; nothing is charged from a form",
        "Balances are re-read after anything moves, so the cards cannot drift from the account"
      ]
    },
    {
      "dot": "amber",
      "title": "Two rails, and an exchange",
      "items": [
        "PayPal AI Crowdfunding: fund a real business in Venezuela from $20, paid in USD — a pledge is a purchase order through these same rails",
        "The campaign's band, goal and return are read from the server's own catalog: a request may name a campaign, it cannot state its goal",
        "Exchange · USD ↔ VES: dollars held by PayPal, bolívares between two people",
        "A condition only a person can confirm — the agent may never settle it alone"
      ]
    }
  ]
