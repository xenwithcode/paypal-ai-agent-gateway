  "cards": [
    {
      "dot": "cyan",
      "title": "Intent to policy",
      "items": [
        "POST /api/agent rejects malformed JSON, empty intent, and anything over 500 chars",
        "Gemini is forced to valid JSON by responseSchema, never parsed from prose",
        "The result lands as a pending row — nothing is live until approved"
      ]
    },
    {
      "dot": "emerald",
      "title": "Human approval",
      "items": [
        "AG Grid renders Active / Protecting / Activate, not internal jargon",
        "Autonomous for small routine spends, Copilot for large ones",
        "Policy and status strings are shared constants in lib/policy.ts"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "lib/paypal.ts is imported by server code only — no client bundle holds secrets",
        "Enforcement is an in-process check today; the OpenShell sandbox is not wired yet",
        "Blocked attempts never reach PayPal, so a local decision log is required"
      ]
    }
  ]
